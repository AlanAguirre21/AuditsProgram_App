{
  "name": "auditsprogram_backend",
  "version": "1.0.0",
  "description": "Programa General de Auditorías — API",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "job:daily": "node src/worker.js --run daily",
    "job:digest": "node src/worker.js --run digest",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/createAdmin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "node scripts/seed.js --demo",
    "dev:demo": "node --watch src/server.js --demo",
    "worker:demo": "node src/worker.js --demo",
    "create-admin:demo": "node scripts/createAdmin.js --demo"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongoose": "^9.12.3",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}

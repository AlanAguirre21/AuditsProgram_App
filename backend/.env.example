# Application
NODE_ENV=development
PORT=3045
CLIENT_ORIGINS=http://localhost:5190
# Base URL used in the links of Teams messages ("Ver auditoría"). Defaults to the first CLIENT_ORIGINS entry.
APP_BASE_URL=http://localhost:5190

# Database (add ?replicaSet=rs0 when MongoDB runs as a replica set; required for transactions)
MONGO_URI=mongodb://127.0.0.1:27017/audits_program

# Authentication (own login + register + Teams 2FA)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# Comma-separated domains allowed to self-register (empty = any domain)
ALLOWED_EMAIL_DOMAINS=zf.com

# Fixed administrator account: created/repaired on every API start (roles, active, password).
# ADMIN_EMAIL = its real email (receives the Teams 2FA codes and notifications).
# ADMIN_USERNAME = optional login alias for it (e.g. admin@zf.com); not a separate user.
ADMIN_EMAIL=
ADMIN_USERNAME=admin@zf.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Teams workflow 1 — 2FA codes (see README)
# Empty URL in development = the code is printed in the API console. Required in production.
TEAMS_2FA_WEBHOOK_URL=
TEAMS_2FA_API_TOKEN=
TWO_FACTOR_CODE_TTL_MINUTES=5
TWO_FACTOR_MAX_ATTEMPTS=5

# Teams workflow 2 — notifications: reminders, escalations, events, weekly digest, optional email copy (see README)
TEAMS_NOTIFY_WEBHOOK_URL=
TEAMS_NOTIFY_API_TOKEN=
# true = log notifications without calling Teams (development/testing)
NOTIFICATIONS_DRY_RUN=true

# PNG logo embedded in the Teams cards (2FA and notifications), path relative to backend/.
# It is trimmed and resized automatically, so the original file can be large. Empty = no logo.
BRAND_LOGO_PATH=../frontend/public/ZF-Logo.png

# Evidence storage
LOCAL_STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=20

# Logging
LOG_LEVEL=info

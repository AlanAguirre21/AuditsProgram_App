# Application
NODE_ENV=development
PORT=3045
CLIENT_ORIGINS=http://localhost:5190
# Base URL used in links (emails/Teams). Defaults to the first CLIENT_ORIGINS entry.
APP_BASE_URL=http://localhost:5190

# Database (add ?replicaSet=rs0 when MongoDB runs as a replica set; required for transactions)
MONGO_URI=mongodb://127.0.0.1:27017/audits_program

# Authentication (own login + register + Teams 2FA)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# Comma-separated domains allowed to self-register (empty = any domain)
ALLOWED_EMAIL_DOMAINS=zf.com

# Teams 2FA workflow (Power Automate "When a HTTP request is received")
#   POST TEAMS_2FA_WEBHOOK_URL  header x-api-key: TEAMS_2FA_API_TOKEN
#   body { email, name, code, purpose: LOGIN|PASSWORD_RESET, expiresInMinutes, appName }
# Empty URL in development = the code is printed in the API console.
TEAMS_2FA_WEBHOOK_URL=
TEAMS_2FA_API_TOKEN=
TWO_FACTOR_CODE_TTL_MINUTES=5
TWO_FACTOR_MAX_ATTEMPTS=5

# Microsoft Graph (Phase 2: email notifications from the service mailbox)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-client-secret
GRAPH_MAILBOX=no-reply@example.com
NOTIFICATIONS_DRY_RUN=true

# Evidence storage
LOCAL_STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=20

# Logging
LOG_LEVEL=info
